# ---- Minecraft server (your TJCOMBO12 server) ----
MC_HOST=127.0.0.1
MC_PORT=25565

# auto = detect the server version, then go direct or through ViaProxy
# direct = Microsoft login straight to the server | viaproxy = always use ViaProxy
MODE=auto

# Name shown for the bot (ViaProxy mode) / your Microsoft account email (direct mode, optional hint)
BOT_NAME=TJ_AI
MS_ACCOUNT=

# Version the bot itself speaks when it goes through ViaProxy (must be supported by Mineflayer)
CLIENT_VERSION=1.21.4
VIAPROXY_PORT=25570

# ---- AI brain (OpenRouter) ----
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/auto

# ---- Website dashboard ----
DASH_PORT=3000
# 0.0.0.0 = reachable from the internet. 127.0.0.1 = only through nginx on this machine.
DASH_HOST=0.0.0.0
# The first admin account is created from these on first start. Manage accounts on the dashboard afterwards.
ADMIN_USER=admin
DASH_PASSWORD=change-me-please
# Behind nginx/Cloudflare set TRUST_PROXY=loopback so the anti-bot guard sees the real visitor IP.
# Leave empty when visitors connect directly (a wrong value lets attackers fake their IP).
TRUST_PROXY=
# IPs that can never be auto-blocked, comma separated (your home/office IP). 127.0.0.1 is always allowed.
ALLOW_IPS=

# Leveling: false = abilities unlock as the AI levels up, true = everything on from the start
UNLOCK_ALL=false
